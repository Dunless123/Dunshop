<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.schoolmarket.mapper.PayPasswordMapper">

    <insert id="insert" parameterType="com.example.schoolmarket.entity.PayPassword">
        INSERT INTO pay_password (user_id, password, created_at, updated_at)
        VALUES (#{userId}, #{password}, #{createdAt}, #{updatedAt})
    </insert>

    <update id="update" parameterType="com.example.schoolmarket.entity.PayPassword">
        UPDATE pay_password
        SET password = #{password}, updated_at = #{updatedAt}
        WHERE id = #{id}
    </update>

    <select id="selectByUserId" parameterType="java.lang.Long" resultType="com.example.schoolmarket.entity.PayPassword">
        SELECT * FROM pay_password WHERE user_id = #{userId}
    </select>

    <delete id="deleteByUserId" parameterType="java.lang.Long">
        DELETE FROM pay_password WHERE user_id = #{userId}
    </delete>

</mapper>